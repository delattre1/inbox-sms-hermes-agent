# Copie pra .env (que esta no .gitignore) e preencha.
#
# Gmail com 2FA nao aceita a senha da conta: gere uma "senha de app" em
# myaccount.google.com > Seguranca > Senhas de app, e use ela aqui.
# iCloud: imap.mail.me.com / smtp.mail.me.com, senha de app do Apple ID.

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=voce@gmail.com
IMAP_PASSWORD=senha-de-app-de-16-letras
IMAP_FOLDER=INBOX

# So o agente de inbox usa. Em branco = o agente nunca envia, so rascunha.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=voce@gmail.com
SMTP_PASSWORD=senha-de-app-de-16-letras
